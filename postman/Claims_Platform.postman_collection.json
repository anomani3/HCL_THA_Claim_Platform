{
  "info": {
    "name": "Claims Platform",
    "description": "All requests go through the API gateway (baseUrl). Start with the 'Lifecycle walkthrough' folder and run it in order (Runner or newman): it creates claims, drives them through the state machine, and includes negative tests (409 / 403 / 422 / 400). Then run 'Reports'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
