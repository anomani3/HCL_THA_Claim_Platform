    {
      "name": "1. Lifecycle walkthrough (run in order)",
      "item": [
        {
          "name": "1. Submit MOTOR claim (claimant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimType\": \"MOTOR\",\n  \"market\": \"SG\",\n  \"currency\": \"SGD\",\n  \"policyNumber\": \"POL-MTR-889012\",\n  \"claimantId\": \"{{claimantId}}\",\n  \"claimantName\": \"Tan Wei Ming\",\n  \"claimantEmail\": \"{{claimantEmail}}\",\n  \"incidentDate\": \"2026-10-30\",\n  \"incidentLocation\": \"PIE near Clementi exit\",\n  \"assetReference\": \"SGX1234A\",\n  \"description\": \"Rear-ended at traffic light. Damage to rear bumper and boot.\",\n  \"claimedAmount\": 4500.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"claimId\", j.id);",
                  "pm.collectionVariables.set(\"claimNumber\", j.claimNumber);",
                  "pm.test(\"claim status is SUBMITTED\", () => pm.expect(pm.response.json().status).to.eql(\"SUBMITTED\"));"
                ]
              }
            }
          ]
        },
